# 生产环境 — 由 deploy 脚本在服务器生成，勿提交 Git
DATABASE_URL=sqlite:///./data/app.db
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000
JWT_SECRET=CHANGE_ME_ON_DEPLOY
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo123456
PUBLIC_RATE_LIMIT=30
PUBLIC_AI_USERNAME=admin
AI_DAILY_COST_LIMIT_YUAN=1
CORS_ORIGINS=https://un.easytransfer.top,https://www.easytransfer.top,http://localhost:5174,http://127.0.0.1:5174
DEBUG=false
APP_VERSION=0.1.0
